{
  "name": "budget-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev tests/local-preview --webpack --hostname 127.0.0.1 --port 3010",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --import ./tests/register-ts.mjs --test tests/finance.test.mjs tests/date-range.test.mjs tests/priorities.test.mjs tests/simulation.test.mjs tests/theme.test.mjs tests/inactivity.test.mjs tests/postgres.test.mjs tests/access.test.mjs tests/simple-ui.test.mjs tests/revenue.test.mjs tests/workspaces.test.mjs tests/budget-scenarios.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/migrate-postgres.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
