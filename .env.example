# Never commit real credentials. Copy to .env.local for development.
APP_URL=http://localhost:3000
DATABASE_DRIVER=pg
DATABASE_URL=postgresql://budget_os:REPLACE_WITH_HEX_PASSWORD@127.0.0.1:5432/budget_os
# Used by compose.yaml; generate your own random hex value.
POSTGRES_PASSWORD=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional one-time migration of a pre-workspace installation only.
# Leave unset for new installations; every verified user gets a private workspace.
BUDGET_OWNER_EMAIL=
